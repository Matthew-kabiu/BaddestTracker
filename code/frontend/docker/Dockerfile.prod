# Build the SPA once, then serve it with nginx. Nothing environment-specific is baked: the public
# origin (SITE_URL) and service ports are rendered when the container starts.
FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false
COPY . .
RUN pnpm build

# Unprivileged build of the official image: nginx runs as uid 101, not root. It keeps the pid file
# in /tmp and lets that user write conf.d, so the template step below still works.
FROM nginxinc/nginx-unprivileged:alpine
USER root
RUN rm -rf /usr/share/nginx/html/*
# Owned by nginx so 15-site.envsh can render index.html, robots.txt and sitemap.xml at start.
COPY --from=builder --chown=101:101 /app/dist /usr/share/nginx/html
# nginx's entrypoint envsubsts templates/*.template into conf.d/ — listen port = ${FRONTEND_PORT}.
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
# Rendered to conf.d/security-headers.inc (not *.conf, so nginx does not load it as a server block).
COPY docker/security-headers.conf.template /etc/nginx/templates/security-headers.inc.template
COPY --chmod=755 docker/15-site.envsh /docker-entrypoint.d/15-site.envsh
USER 101
CMD ["nginx", "-g", "daemon off;"]
