# Non-secret development defaults. scripts/init-env.py generates private credentials.
# Production requires --site-url and --frontend-host-port; never reuse development secrets.
APP_ENV=development
LOG_LEVEL=info
HOST_BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=http://localhost:5173
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5440
BACKEND_PORT=8080
BACKEND_HOST_PORT=8090
FRONTEND_PORT=5173
FRONTEND_HOST_PORT=5173
AUTH_PORT=3000
AUTH_HOST_PORT=8091
POSTGRES_DB=baddest
POSTGRES_USER=baddest
POSTGRES_PASSWORD=GENERATE_WITH_INIT_ENV
DATABASE_URL=GENERATE_WITH_INIT_ENV
DB_MAX_CONNS=10
BETTER_AUTH_SECRET=GENERATE_WITH_INIT_ENV
# The browser reaches auth and the API through the gateway, so auth's public URL is the site origin.
BETTER_AUTH_URL=http://localhost:5173
AUTH_INTERNAL_URL=http://auth:3000
AUTH_COOKIE_DOMAIN=localhost
AI_KEYS_ENCRYPTION_KEY=GENERATE_WITH_INIT_ENV
# Public site origin, read when the frontend container starts. Not baked into the image.
SITE_URL=http://localhost:5173

# Disposable CI configuration only; never used for a real deployment.
CI_SITE_URL=https://example.invalid
CI_FRONTEND_HOST_PORT=3000
